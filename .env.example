# Environment Variables Template
# Copy this to .env.local for local development
# For Vercel deployment, add these in the Vercel dashboard under Environment Variables

# ===== PRIMARY AI PROVIDER (Choose one) =====

# Groq API Configuration (Recommended - Fast & Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== ALTERNATIVE AI PROVIDERS (Optional) =====

# Google Gemini API
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API (Access to multiple models)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-flash-1.5
# OPENROUTER_APP_NAME=AI Chat App

# HuggingFace API
# HF_TOKEN=your_huggingface_token_here
# HF_MODEL=google/gemma-2b-it

# ===== AUTHENTICATION (Required for NextAuth) =====

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Generate a secret: openssl rand -base64 32 (or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_command_above
NEXTAUTH_URL=http://localhost:3000

# ===== APPLICATION SETTINGS =====

# Public URL of your application
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
